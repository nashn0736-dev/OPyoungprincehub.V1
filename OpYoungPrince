local function harvestCrop()
    -- PUT YOUR ACTUAL HARVEST FUNCTION HERE
    --
    -- Example if your own game has:
    -- ReplicatedStorage.Remotes.Harvest:FireServer()
    --
    -- DO NOT GUESS THE REMOTE NAME.

    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")

    if not Remotes then
        return
    end

    local Harvest = Remotes:FindFirstChild("Harvest")

    if Harvest and Harvest:IsA("RemoteEvent") then
        Harvest:FireServer()
    end
end

local function sellInventory()
    -- PUT YOUR ACTUAL SELL FUNCTION HERE

    local Remotes = ReplicatedStorage:FindFirstChild("Remotes")

    if not Remotes then
        return
    end

    local Sell = Remotes:FindFirstChild("SellInventory")

    if Sell and Sell:IsA("RemoteEvent") then
        Sell:FireServer()
    end
end

