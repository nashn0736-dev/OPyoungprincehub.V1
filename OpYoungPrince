    Button.Size = UDim2.fromOffset(48, 25)
    Button.Position = UDim2.new(1, -62, 0.5, -12)
    Button.BackgroundColor3 = Color3.fromRGB(55, 60, 70)
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.Parent = Holder

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(1, 0)
    ButtonCorner.Parent = Button

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.fromOffset(19, 19)
    Knob.Position = UDim2.new(0, 3, 0.5, -9)
    Knob.BackgroundColor3 = Color3.fromRGB(225, 230, 235)
    Knob.Parent = Button

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local state = false

    Button.MouseButton1Click:Connect(function()

        state = not state

        if state then
            Button.BackgroundColor3 = Color3.fromRGB(45, 190, 225)
            Knob.Position = UDim2.new(1, -22, 0.5, -9)
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            Button.BackgroundColor3 = Color3.fromRGB(55, 60, 70)
            Knob.Position = UDim2.new(0, 3, 0.5, -9)
            Label.TextColor3 = Color3.fromRGB(225, 232, 240)
        end

        callback(state)
    end)
end

